# --- Google (OAuth client for Drive read + YouTube upload) ---
# Path to the OAuth client secrets JSON downloaded from Google Cloud Console
GOOGLE_CLIENT_SECRETS_FILE=./client_secrets.json
# Where the granted OAuth token is cached after first login
GOOGLE_TOKEN_FILE=./token.json

# --- Google Drive ---
# Folder that contains the video, transcript, PPTs and optional settings.json
DRIVE_FOLDER_ID=
# Server mode (submission_workflow.server): a parent folder whose subfolders are
# the submissions listed by the WebMCP front-end. Either this or DRIVE_FOLDER_ID.
DRIVE_PARENT_FOLDER_ID=

# --- YouTube ---
# 27 = Education (see videoCategories.list for your region)
YOUTUBE_CATEGORY_ID=27
# Days from now until the scheduled public launch
YOUTUBE_PUBLISH_DELAY_DAYS=2

# --- X (OAuth 1.0a user context keys from the developer portal) ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Target length for the pre-post text
X_MAX_POST_CHARS=210

# --- LinkedIn ---
# Member token with w_member_social (or org token with w_organization_social)
LINKEDIN_ACCESS_TOKEN=
# urn:li:person:{id} or urn:li:organization:{id}
LINKEDIN_AUTHOR_URN=
# Versioned API month, YYYYMM
LINKEDIN_VERSION=202608

# --- HTTP server for the WebMCP front-end (uvicorn submission_workflow.server:app) ---
# Path to the webmcps repo; when set, the server serves it as static files on the
# same origin as /api (WebMCP tools are same-origin; origin-trial tokens are per origin).
WEBMCP_DIR=../webmcps
# Chrome origin-trial token for WebMCP, sent as the Origin-Trial header on HTML.
ORIGIN_TRIAL_TOKEN=
# Extra origins allowed to call /api (dev: front-end on python -m http.server 8080)
CORS_ORIGINS=http://localhost:8080
# Where downloaded videos are staged before upload
WORK_DIR=out
